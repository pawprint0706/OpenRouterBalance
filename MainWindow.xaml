<Window x:Class="OpenRouterBalance.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="OpenRouter Balance"
        Width="480" Height="800"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen">

    <Grid x:Name="rootGrid">
        <wv2:WebView2 x:Name="webView" />

        <!-- WebView2(네이티브 HWND) 위에 항상 표시되도록 Popup 사용 -->
        <Popup x:Name="fabPopup"
               PlacementTarget="{Binding ElementName=rootGrid}"
               Placement="Custom"
               AllowsTransparency="True"
               StaysOpen="True">
            <!-- 우측 하단 새로고침 플로팅 버튼 -->
            <Button x:Name="fabReload"
                Width="52" Height="52"
                Click="FabReload_Click"
                ToolTip="새로고침"
                Cursor="Hand">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Ellipse x:Name="bg" Fill="#1976D2">
                            <Ellipse.Effect>
                                <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.4" />
                            </Ellipse.Effect>
                        </Ellipse>
                        <TextBlock Text="&#xE72C;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="22"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bg" Property="Fill" Value="#1565C0" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
            </Button>
        </Popup>
    </Grid>
</Window>
